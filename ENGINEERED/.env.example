# Copy to .env and adjust for your event.
# Local stall database (embedded PostgreSQL is started by `npm run stall`)
DATABASE_URL="postgresql://engineered:engineered@localhost:55432/engineered"

# Admin passcode for /admin (change for your event)
ADMIN_PASSCODE="CHANGE-ME"

# Public base URL used for QR codes on result cards (no trailing slash)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
